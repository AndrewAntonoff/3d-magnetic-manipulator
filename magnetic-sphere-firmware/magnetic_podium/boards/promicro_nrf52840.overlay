&pinctrl {
    uart1_default: uart1_default {
        group1 {
            /* Назначаем пины для TX и RX. 
               ВАЖНО: замените нули и девятки на реальные номера пинов (Port и Pin), 
               к которым вы подключили провода до STM32.
               Например, NRF_PSEL(UART_TX, 0, 9) означает Порт 0, Пин 9. */
            psels = <NRF_PSEL(UART_TX, 0, 17)>,
                    <NRF_PSEL(UART_RX, 0, 20)>;
        };
    };
    
    uart1_sleep: uart1_sleep {
        group1 {
            psels = <NRF_PSEL(UART_TX, 0, 17)>,
                    <NRF_PSEL(UART_RX, 0, 20)>;
            low-power-enable;
        };
    };
};

&uart1 {
    status = "okay";
    current-speed = <115200>;
    pinctrl-0 = <&uart1_default>;
    pinctrl-1 = <&uart1_sleep>;
    pinctrl-names = "default", "sleep";
};